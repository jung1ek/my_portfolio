---
import { site } from '../data/site';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/writing/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];

function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/">{site.shortName}</a>
    <nav class="nav" id="site-nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a href={site.social.github} rel="noopener noreferrer">GitHub</a>
    </nav>
    <div class="header-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 3v2M12 19v2M5 12H3M21 12h-2M6.2 6.2 4.8 4.8M19.2 19.2l-1.4-1.4M6.2 17.8l-1.4 1.4M19.2 4.8l-1.4 1.4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
          <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"></circle>
        </svg>
      </button>
      <button
        class="icon-btn menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector('[data-theme-toggle]');
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  menuToggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
