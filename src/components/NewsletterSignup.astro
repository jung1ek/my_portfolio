---
import { site } from '../data/site';
---

{site.newsletter.enabled && (
  <section class="newsletter" aria-labelledby="newsletter-heading">
    <h2 id="newsletter-heading">{site.newsletter.heading}</h2>
    <p>{site.newsletter.blurb}</p>
    {site.newsletter.action ? (
      <form action={site.newsletter.action} method="post">
        <label class="visually-hidden" for="email">Email</label>
        <input id="email" name="email" type="email" required placeholder="you@example.com" autocomplete="email" />
        <button class="btn" type="submit">Subscribe</button>
      </form>
    ) : (
      <p class="meta">
        Placeholder form — set <code>site.newsletter.action</code> in <code>src/data/site.ts</code> when you have a
        provider.
      </p>
    )}
  </section>
)}
