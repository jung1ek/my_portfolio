---
import { site } from '../data/site';
---

<div class="btn-row">
  <a class="btn" href={site.social.github} rel="noopener noreferrer">GitHub</a>
  <a class="btn btn--ghost" href={site.social.linkedin} rel="noopener noreferrer">LinkedIn</a>
  <a class="btn btn--ghost" href={`mailto:${site.email}`}>Email</a>
</div>
