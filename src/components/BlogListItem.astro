---
import { formatDate, postUrl, readingTime, type Post } from '../lib/content';
import Tags from './Tags.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = postUrl(post);
const minutes = readingTime(post.body ?? '');
---

<article class="blog-item">
  <div>
    <h2><a href={href}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <p class="meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      · {minutes}
    </p>
    <Tags tags={post.data.tags} />
  </div>
  <a class="blog-thumb" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={post.data.image}
      alt=""
      width="420"
      height="336"
      loading="lazy"
      decoding="async"
    />
  </a>
</article>
