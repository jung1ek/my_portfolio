---
import { formatDate, postUrl, type Post } from '../lib/content';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div class="writing-list">
  {posts.map((post) => (
    <a class="writing-row" href={postUrl(post)}>
      <span class="writing-row__title">{post.data.title}</span>
      <time class="writing-row__date" datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date)}
      </time>
    </a>
  ))}
</div>
